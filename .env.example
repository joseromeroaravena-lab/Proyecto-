# Copia este archivo a .env y establece la contraseña para abrir el panel.
CESFAM_PANEL_PASSWORD=
# Si queda vacía, se usa chatbot.db en la raíz del proyecto.
CESFAM_DB_PATH=

# Configuración opcional de WhatsApp. Consulta WHATSAPP.md.
WA_API_VERSION=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_ALLOWED_RECIPIENTS=
WA_REMINDER_TEMPLATE=
WA_TEMPLATE_LANGUAGE=

# Los envíos y el modo de botones quedan desactivados por defecto.
WA_SEND_ENABLED=
WA_TEST_NUMBER_CONFIRMED=
WA_REMINDER_BUTTONS=
